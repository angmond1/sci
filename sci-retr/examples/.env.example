# sci-retr .env 예시
#
# 이 파일을 논문 폴더 root 로 복사해 이름을 .env 로 바꾸고 값을 채운다 (예: D:\papers\my_topic\.env).
# 값이 없어도 된다. 그러면 Elsevier·Wiley 는 평소 쓰는 Chrome 에서 받는다 (SKILL.md 3.2).
#
# .env 는 git 에 올리지 않는다 (.gitignore 에 있음). 값은 다른 사람과 공유하지 않는다.

# ===== Wiley TDM 토큰 =====
# 발급: https://onlinelibrary.wiley.com/library-info/resources/text-and-datamining (기관 구독이 있으면 무료)
# 용도: Wiley 논문(10.1002) PDF 자동 수집. 구독 논문은 기관 IP 대역에서만 유효.
WILEY_TDM_TOKEN=

# ===== Elsevier API 키 =====
# 발급: https://dev.elsevier.com/ (무료, 몇 분)
# 용도: Elsevier OA 논문(10.1016, 10.1006) 본문 XML + PDF. 구독 논문(OA 아님)에는 쓰지 않는다.
ELSEVIER_API_KEY=

# ===== (선택) Chrome 실행 파일 경로 =====
# 기본값 C:\Program Files\Google\Chrome\Application\chrome.exe 가 아닐 때만.
CHROME_EXE=
